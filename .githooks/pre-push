#!/usr/bin/env bash
# Customer demo branches/tags may only leave this machine for a GitHub
# repository whose visibility GitHub reports as PRIVATE.
set -euo pipefail

remote_name="${1:-origin}"
remote_url="${2:-$(git remote get-url "$remote_name" 2>/dev/null || true)}"
customer_ref=""

while read -r local_ref _local_sha remote_ref _remote_sha; do
  case "$local_ref:$remote_ref" in
    refs/heads/customer/*:* | *:refs/heads/customer/* | \
    refs/tags/customer-seed/*:* | *:refs/tags/customer-seed/*)
      customer_ref="${local_ref#refs/heads/}"
      break
      ;;
  esac
done

[[ -n "$customer_ref" ]] || exit 0

slug=$(printf '%s' "$remote_url" \
  | sed -E 's#^git@github.com:##; s#^https://github.com/##; s#\.git$##')
visibility=""
if [[ "$slug" =~ ^[^/]+/[^/]+$ ]] && command -v gh >/dev/null 2>&1; then
  visibility=$(env -u GH_TOKEN -u GITHUB_TOKEN gh repo view "$slug" \
    --json visibility --jq '.visibility' 2>/dev/null || true)
fi

if [[ "$visibility" != "PRIVATE" ]]; then
  echo "Blocked push of customer ref '$customer_ref' to '$remote_name' (${visibility:-visibility unverified})." >&2
  echo "Customer demo refs may only be pushed to a verified private GitHub repository." >&2
  exit 1
fi
