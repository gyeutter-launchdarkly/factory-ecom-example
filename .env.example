# DarkCommerce Checkout Demo, environment config.
# Copy to .env.local and fill in. Never commit .env.local.
#
# `bash demo/setup.sh` writes this file for you; these notes are for setting it
# up by hand. See docs/MANUAL-SETUP.md.

# ── LaunchDarkly project ─────────────────────────────────────────────────────
# The project the factory creates flags in, and reads its own AI configs from.
# It must already exist; the demo never creates or destroys projects.
LD_APP_PROJECT_KEY=checkout-demo

# Environment within that project used by the app and by Terraform.
LD_ENVIRONMENT_KEY=production

# ── LaunchDarkly API token (Admin) ───────────────────────────────────────────
# Creates the seed flag, the AutoFactory View, and the flags and metrics the
# factory produces. Also used by `make reset` to delete them again.
#   https://app.launchdarkly.com/settings/authorization
LD_API_KEY=api-

# ── LaunchDarkly SDK key ─────────────────────────────────────────────────────
# One key serves both: the app evaluates flags with it, and the factory reads
# its agent AI configs with it.
#   https://app.launchdarkly.com/settings/sdk-keys
LD_SDK_KEY=sdk-

# ── Anthropic API key ────────────────────────────────────────────────────────
# Runs the agents.
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-

# ── GitHub personal access token ─────────────────────────────────────────────
# Opens PRs, posts the factory's comment and check run, pushes its commits, and
# closes PRs on reset. Fine-grained token with Contents and Pull requests both
# set to Read and write.
#   https://github.com/settings/personal-access-tokens/new
#
# Writing the repo's Actions secrets and variables needs permissions this token
# does not have; those calls use your `gh auth login` session instead.
GITHUB_TOKEN=

# ── Phase 2 / deploy SHA ─────────────────────────────────────────────────────
# Set by your CD platform at deploy time (e.g. $RAILWAY_GIT_COMMIT_SHA).
# Locally leave blank: /api/status reports "dev".
DEPLOY_SHA=
