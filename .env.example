# ─────────────────────────────────────────────────────────────────────────────
# Meridian Checkout Demo — environment config
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Demo app project key ──────────────────────────────────────────────────────
# The key Terraform will use when creating the demo LD project.
# Must be unique in your account; lowercase letters, numbers, hyphens only.
LD_APP_PROJECT_KEY=checkout-demo

# ── LaunchDarkly API access token ────────────────────────────────────────────
# Used by Terraform (create/destroy the demo project) and by the AutoFactory
# GitHub Action (create flags and metrics in the demo project at PR time).
# Needs Writer or Admin role.
#
# How to get it:
#   1. Go to https://app.launchdarkly.com/settings/authorization
#   2. Click "Create token" (top right)
#   3. Name it "checkout-demo", choose Role: Writer
#   4. Copy the token — it starts with api-
LD_API_KEY=api-

# ── LaunchDarkly server SDK key (demo app runtime) ───────────────────────────
# The demo app uses this key to evaluate feature flags at runtime
# (e.g. show-product-reviews). This is the DEMO APP project's key,
# NOT the factory project's key (those are separate GitHub Action secrets).
#
# How to get it (after `make setup` or `terraform apply`):
#   1. Go to https://app.launchdarkly.com
#   2. Select the "Checkout Demo" project from the top-left project switcher
#   3. Click "Environments" in the left nav → select "Production"
#   4. Under "SDK keys", click "..." → "Copy SDK key"
#      (it starts with sdk-)
#
# Tip: `terraform output production_sdk_key_hint` also prints the direct URL.
LD_SDK_KEY=sdk-

# ── Phase 2 / deploy SHA ─────────────────────────────────────────────────────
# Set by your CD platform at deploy time (e.g. $RAILWAY_GIT_COMMIT_SHA).
# Locally: leave blank — /api/status returns "dev".
DEPLOY_SHA=
